# Copie para ".env" e preencha. O arquivo .env fica fora do git (.gitignore).
# Estas variaveis configuram o envio de e-mail do notificador.py.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
# No Gmail, gere uma "Senha de app" (nao use a senha normal da conta):
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=seu_email@gmail.com
AGENDA_EMAIL_TO=destinatario@exemplo.com
