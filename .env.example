# Copie para ".env" e preencha. O arquivo .env fica fora do git (.gitignore).
# Email e Telegram sao opcionales — configure um ou ambos.

# --- E-MAIL (opcional) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
# No Gmail, gere uma "Senha de app" (nao use a senha normal da conta):
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD=sua_senha_de_app
SMTP_FROM=seu_email@gmail.com
AGENDA_EMAIL_TO=seu_email@gmail.com

# --- TELEGRAM (opcional) ---
# 1. Abra o Telegram e procure por @BotFather
# 2. Digite /newbot e siga as instrucoes para criar seu bot
# 3. Copie o token (ex.: 123456789:ABCxyz...)
TELEGRAM_BOT_TOKEN=seu_token_aqui
# Seu chat_id (numero). Encontre digitando /start no seu bot e checando raw updates,
# ou use um bot como @userinfobot para descobrir seu ID de usuario.
TELEGRAM_CHAT_ID=seu_chat_id_aqui
